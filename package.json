{
  "name": "engineering-knowledge-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "ai:up": "docker compose up -d ollama",
    "ai:down": "docker compose stop ollama",
    "ai:pull-embedding-model": "tsx scripts/pull-model.ts",
    "ai:pull-chat-model": "tsx scripts/pull-model.ts qwen2.5:3b-instruct",
    "ocr:pull-language-data": "tsx scripts/pull-ocr-language-data.ts",
    "seed:dev-user": "tsx scripts/seed-dev-user.ts",
    "reset-demo": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@vercel/blob": "^2.8.2",
    "@whiskeysockets/baileys": "6.7.24",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5"
  }
}
