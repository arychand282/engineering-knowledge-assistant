# Engineering Knowledge Assistant — environment variables
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env or .env.local.

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL + pgvector (see docker-compose.yml)
POSTGRES_USER=eka
POSTGRES_PASSWORD=eka_dev_password
POSTGRES_DB=engineering_knowledge_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eka:eka_dev_password@localhost:5432/engineering_knowledge_assistant

# Embedding vector dimension. Must match EMBEDDING_MODEL's native output size below.
# This pairing (nomic-embed-text / 768) is PROVISIONAL — a dev default, not a final
# model choice (that needs an Indonesian-language benchmark + license sign-off per
# PLANNING.md #3/#18). Changing either value after data exists requires a new Drizzle
# migration and re-embedding all existing document_chunks rows.
EMBEDDING_DIMENSIONS=768

# Document ingestion (Task 3). Uploaded files are stored on local disk outside of
# public/, never in Git (see storage/.gitignore).
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=1000
# Chunking uses a word-count approximation of tokens (no external tokenizer/API).
CHUNK_SIZE_WORDS=700
CHUNK_OVERLAP_WORDS=100
# DOCX has no stored pagination, so it's converted to PDF via headless LibreOffice
# before reusing the PDF pipeline. Only matters for DOCX uploads; PDF uploads never
# touch either of these two settings.
DOCX_CONVERT_TIMEOUT_MS=60000
# Default "soffice" works out of the box after `apt install libreoffice` or
# `brew install --cask libreoffice` (both verified to put it on PATH). Only override if
# some other install method doesn't, e.g.:
# SOFFICE_BINARY=/Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_BINARY=soffice

# Local OCR (tesseract.js + @napi-rs/canvas for PDF rasterization) for pages flagged
# ocr_required (image present, no text layer — likely a scan). Default ON: can only
# improve a page that was otherwise completely unusable, costs latency once at upload
# time (not per chat question), and degrades gracefully to today's ocr_required
# behavior on any failure. Run `npm run ocr:pull-language-data` once before using —
# OCR_LANG_DATA_DIR is NEVER left empty/unset at request time: tesseract.js's own
# default behavior is to fetch language data from a CDN on first use, which this
# project never does implicitly for anything.
OCR_ENABLED=true
OCR_LANGUAGES=ind+eng
OCR_LANG_DATA_DIR=ocr-lang-data
OCR_TIMEOUT_MS=120000
# Below this (tesseract's own 0-100 confidence score), an OCR result is discarded
# rather than persisted as if it were reliable text. Not benchmarked against a real
# scanned-document dataset — a reasonable starting default, not a tuned value.
OCR_MIN_CONFIDENCE=60

# Local AI runtime (Ollama — see docker-compose.yml service "ollama"). Never pointed at
# a cloud endpoint; embedding/chat text never leaves this host, unless you explicitly
# opt into EMBEDDING_PROVIDER/CHAT_PROVIDER below.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_MS=30000

# ============================================================================
# OPTIONAL, OPT-IN exception to "no external AI" — see PLANNING.md "Mode Embedding
# Eksternal". Leave EMBEDDING_PROVIDER=local (the default) for normal use. Only set
# it to gemini/openai for a demo without a local embedding model pulled —
# doing so sends document chunk TEXT (at upload time) and every chat question's TEXT
# (at query time) to that provider's cloud API. NEVER use this with real/confidential
# company documents until company policy formally approves an external AI vendor
# (PLANNING.md #18 decision 1). Anthropic has no embeddings API, so it's not a valid
# value here (it is for CHAT_PROVIDER below). Changing this (or EMBEDDING_DIMENSIONS)
# after data exists requires re-embedding all existing document_chunks rows.
# ============================================================================
EMBEDDING_PROVIDER=local
EXTERNAL_EMBEDDING_TIMEOUT_MS=30000
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local LLM chat (Task 5). CHAT_MODEL / its license are PROVISIONAL dev defaults, same
# caveat as EMBEDDING_MODEL above — not a benchmarked/approved final choice.
# OLLAMA_CHAT_TIMEOUT_MS is generous because CPU-only inference (no GPU assumed in dev)
# is slow; budget for real GPU hardware before relying on this in production.
CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_CHAT_TIMEOUT_MS=900000
CHAT_RETRIEVAL_LIMIT=6
# Prior turns (user+assistant messages) sent to the model as conversation history so a
# follow-up question in the same conversation isn't answered in isolation.
CHAT_HISTORY_LIMIT=10

# Opt-in local reranker: one extra chat-model call (Ollama only, regardless of
# CHAT_PROVIDER) scores/reorders retrieved chunks before the top CHAT_RETRIEVAL_LIMIT is
# used. Roughly doubles chat latency per question when enabled — default stays false.
RERANK_ENABLED=false
RERANK_CANDIDATE_LIMIT=20

# ============================================================================
# OPTIONAL, OPT-IN exception to "no external AI" — see PLANNING.md "Mode Chat
# Eksternal". Leave CHAT_PROVIDER=local (the default) for normal use. Only set
# it to gemini/openai/anthropic for a FAST DEMO on hardware without a GPU —
# doing so sends the user's question and retrieved document chunk TEXT to that
# provider's cloud API. NEVER use this with real/confidential company
# documents until company policy formally approves an external AI vendor
# (PLANNING.md #18 decision 1). This setting never affects embedding — that has its
# own independent EMBEDDING_PROVIDER flag above. Full-text retrieval is always local.
# ============================================================================
CHAT_PROVIDER=local
EXTERNAL_CHAT_TIMEOUT_MS=60000
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# The following variable will be added in a later task (auth):
# SESSION_SECRET=

# Authenticates Vercel Cron's call to /api/v1/admin/reset-demo (and manual calls to the
# same route via `npm run reset-demo`). Only needed if that route is actually deployed
# and scheduled (see vercel.json) — e.g. a public demo deployment that shares one admin
# login and needs to self-heal periodically.
# CRON_SECRET=

# ============================================================================
# WhatsApp integration — OPTIONAL, OPT-IN, same class of exception as CHAT_PROVIDER
# above (PLANNING.md #18 decision 9). Default "none": nothing WhatsApp-related runs
# unless explicitly turned on. Built because the client explicitly asked to chat via
# WhatsApp — not built speculatively.
#
# "baileys" = unofficial (whatsapp-rust-bridge-backed WhatsApp Web protocol client, NOT
# Meta's API). Links a real WhatsApp account via one-time QR-code pairing from
# /admin/whatsapp — no Meta Business verification needed, fastest path to something
# testable. Against WhatsApp's Terms of Service; the linked phone number can be banned.
# Demo/dev use only, same caveat as CHAT_PROVIDER=gemini/openai/anthropic above.
#
# "meta" = official WhatsApp Cloud API (Graph API). Requires a verified Meta Business
# account and all four WHATSAPP_META_* values below. Switch to this once the client
# registers with Meta — not before.
# ============================================================================
WHATSAPP_PROVIDER=none
WHATSAPP_SESSION_DIR=whatsapp-session
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_VERIFY_TOKEN=
# WHATSAPP_META_APP_SECRET=
