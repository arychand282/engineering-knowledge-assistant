# Engineering Knowledge Assistant — environment variables
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env or .env.local.

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL + pgvector (see docker-compose.yml)
POSTGRES_USER=eka
POSTGRES_PASSWORD=eka_dev_password
POSTGRES_DB=engineering_knowledge_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eka:eka_dev_password@localhost:5432/engineering_knowledge_assistant

# Embedding vector dimension. This is PROVISIONAL until a local embedding model is
# selected in Task 4 (Local embeddings and retrieval). Changing this value requires a
# new Drizzle migration and re-embedding all existing document_chunks rows.
EMBEDDING_DIMENSIONS=768

# Document ingestion (Task 3). Uploaded files are stored on local disk outside of
# public/, never in Git (see storage/.gitignore).
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=1000
# Chunking uses a word-count approximation of tokens (no external tokenizer/API).
CHUNK_SIZE_WORDS=700
CHUNK_OVERLAP_WORDS=100

# The following variables will be added in later tasks (local AI runtime, auth):
# OLLAMA_BASE_URL=
# SESSION_SECRET=
