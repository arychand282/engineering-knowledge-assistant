# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded documents (never commit real company documents)
/storage/*
!/storage/.gitkeep

# pulled OCR language data (npm run ocr:pull-language-data) — binary model files, not source
/ocr-lang-data/*
!/ocr-lang-data/.gitkeep

# Baileys WhatsApp session credentials (whoever holds these can send/receive as the
# linked phone number — never commit, same sensitivity class as a session token)
/whatsapp-session/*
!/whatsapp-session/.gitkeep

# local Claude Code harness state (not part of the application)
/.claude/
